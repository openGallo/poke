# Example names only. The application does NOT automatically read .env files.
# Prefer `python -m ember setup` which writes an ignored, private runtime/config.json.
# Export variables explicitly, or supply them via your deployment secret manager.
EMBER_DATA_DIR=runtime
EMBER_PUBLIC_URL=http://127.0.0.1:8000
EMBER_SCHEDULER=true
# These must be generated securely; there are intentionally no usable defaults.
# EMBER_PASSWORD_HASH=
# EMBER_ENCRYPTION_KEY=
# EMBER_MONITOR_TOKEN=
