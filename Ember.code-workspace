{
  "folders": [{"path": "."}],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": ["tests"],
    "files.exclude": {"**/__pycache__": true},
    "search.exclude": {".venv": true, "runtime": true, "dist": true}
  },
  "extensions": {"recommendations": ["ms-python.python", "ms-python.debugpy"]},
  "launch": {"version": "0.2.0", "configurations": [
    {"name": "Ember desktop", "type": "debugpy", "request": "launch", "module": "ember.desktop", "args": ["--debug"], "justMyCode": true},
    {"name": "Ember in browser", "type": "debugpy", "request": "launch", "module": "ember.desktop", "args": ["--browser"], "justMyCode": true}
  ]},
  "tasks": {"version": "2.0.0", "tasks": [
    {"label": "Ember: install development dependencies", "type": "shell", "command": "python3 -m venv .venv && .venv/bin/python -m pip install -r requirements-dev.lock -r requirements-desktop.lock", "problemMatcher": []},
    {"label": "Ember: verify", "type": "process", "command": "${workspaceFolder}/.venv/bin/python", "args": ["-m", "pytest"], "group": "test", "problemMatcher": []},
    {"label": "Ember: build Mac app", "type": "process", "command": "${workspaceFolder}/.venv/bin/python", "args": ["scripts/build_macos.py"], "problemMatcher": []}
  ]}
}
